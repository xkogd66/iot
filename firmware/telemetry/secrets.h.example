// Template for telemetry/secrets.h — copy to secrets.h and edit. Gitignored.
//
// These are FALLBACK values only. Normal per-board setup is the config portal
// (hold B, press+release reset), which stores host/port/site/room/id in EEPROM
// and overrides everything here. These defines are what a board uses when its
// EEPROM has no config yet — a freshly flashed board, or after `cfg clear`.
//
// Wi-Fi credentials are deliberately NOT here. connectWiFi() calls the no-arg
// WiFi.begin(), which reads SSID/password from EEPROM as written by the config
// portal. Do not add WIFI_SSID / WIFI_PASSWORD back.
#ifndef SECRETS_H
#define SECRETS_H

// --- MQTT broker ---
// 192.168.1.211 is the MetalLB LB IP, reachable only on the home LAN.
// iot.ekskog.net is the same broker from anywhere — prefer it if boards travel.
#define MQTT_BROKER_HOST "iot.ekskog.net"
#define MQTT_BROKER_PORT 1883

// --- Identity: topic is sensors/<SITE>/<ROOM> ---
// MQTT_CLIENT_ID must be unique per board — two boards sharing one will kick
// each other off the broker in a loop.
#define SITE            "home"
#define ROOM            "livingroom"
#define MQTT_CLIENT_ID  "az3166-livingroom"

#endif // SECRETS_H
