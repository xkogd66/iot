# PlatformIO
.pio/
firmware/.pio/

# macOS
.DS_Store

# Secrets (Wi-Fi credentials, broker host) — keep out of the repo.
# telemetry/secrets.h holds the compiled-in fallback config and real Wi-Fi
# credentials; it must never be committed. secrets.h.example is the template.
firmware/telemetry/secrets.h
firmware/src/secrets.h

# k8s secrets: only SealedSecrets (*.sealed.yaml) are safe to commit. Plaintext
# Secret sources must never land in git — seal them, then delete the source.
**/secret.yaml
**/*.secret.yaml
!**/*.sealed.yaml

# arduino-cli build output
firmware/**/build/

# scratch backups of alternate firmware versions
firmware/src/*.m2bak
firmware/src/*.wifitest
